# ==============================================================================
# MD-LIVE-SERVER CONFIGURATION
# ==============================================================================

# Port to run the live markdown server on (Default: 3456)
PORT=3456

# Host binding (Default: localhost)
HOST=localhost

# Root directory containing Markdown documents to serve (Default: ./_workspace)
# You can set it to relative (e.g. ./docs, ./_workspace, .) or absolute path
DOCS_DIR=./_workspace

# Subdirectory to store notes generated from annotations (Default: <DOCS_DIR>/.notes)
NOTES_DIR=

# Enable / Disable AI Agent integration via CLI (true/false) (Default: true)
AGENT_ENABLED=true

# Command used to invoke the AI agent (Default: agy --continue --print)
# Examples:
#   agy --continue --print
#   claude --continue
#   custom-agent-cli
AGENT_COMMAND=agy --continue --print
